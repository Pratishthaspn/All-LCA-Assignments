# Q5. Find mean of dictionary values

mydict = {
    'marks1': 23,
    'marks2': 123,
    'marks3': 43,
    'marks4': 13,
    'marks5': 39
}

total = 0
count = 0

for value in mydict.values():
    total = total + value
    count = count + 1

mean = total / count

print("\nMean of all values:", mean)


