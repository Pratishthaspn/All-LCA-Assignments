import pandas as pd
import numpy as np

print("--- Step 1: Loading and Inspecting the Raw Dataset ---")

# Let's create a sample student dataset containing some missing values (NaN) and duplicates
student_records = {
    'Student_Name': ['Alice', 'Bob', 'Charlie', 'David', 'Alice', 'Eve', np.nan],
    'Age': [20, 21, np.nan, 22, 20, 23, 21],
    'City': ['Pune', 'Mumbai', 'Pune', np.nan, 'Pune', 'Delhi', 'Mumbai'],
    'Marks': [85, 90, 78, np.nan, 85, 92, 88]
}

# Convert dictionary into a pandas DataFrame
df_students = pd.DataFrame(student_records)

print("\nOriginal Dataset:")
print(df_students)
print("\n" + "="*50 + "\n")


print("--- Step 2: Exploring Dataset Properties ---")

# Quick look at the first few rows
print("1. First few rows using head():")
print(df_students.head())
print()

# Check column data types and non-null counts
print("2. Dataset structure using info():")
print(df_students.info())
print()

# Summary statistics for numerical columns
print("3. Statistical summary using describe():")
print(df_students.describe())
print("\n" + "="*50 + "\n")


print("--- Step 3: Cleaning Missing Values ---")

# Check how many missing values we have per column
print("Missing values count per column:")
print(df_students.isnull().sum())
print()

# Drop rows where the student's name is missing (since name is an essential identifier)
df_students = df_students.dropna(subset=['Student_Name'])

# Fill missing Ages and Marks with the average (mean) value of their respective columns
df_students['Age'] = df_students['Age'].fillna(df_students['Age'].mean())
df_students['Marks'] = df_students['Marks'].fillna(df_students['Marks'].mean())

# Fill missing City values with a default placeholder label
df_students['City'] = df_students['City'].fillna('Unknown')

print("Dataset after handling missing values:")
print(df_students)
print("\n" + "="*50 + "\n")


print("--- Step 4: Handling Duplicate Records ---")

# Check for any duplicate rows in the dataset
duplicate_count = df_students.duplicated().sum()
print(f"Number of duplicate rows found: {duplicate_count}")

# Remove duplicates to keep only unique student records
df_students = df_students.drop_duplicates()

print("\nDataset after removing duplicates:")
print(df_students)
print("\n" + "="*50 + "\n")


print("--- Step 5: Data Selection and Filtering ---")

# Using .loc[] to filter students who scored more than 80 marks 
# and selecting only specific columns for display
top_students = df_students.loc[df_students['Marks'] > 80, ['Student_Name', 'City', 'Marks']]

print("Filtered Records (Students with Marks > 80):")
print(top_students)
print("\n" + "="*50)
print("Data Preprocessing Completed Successfully!")
